# ============================================================
# SoloLedge marketing site — Apache config for Hostinger
# ============================================================

Options -Indexes
DirectoryIndex index.php index.html

# ---- Pretty error page ----
ErrorDocument 404 /404.php

# ---- Force HTTPS + non-www (edit if you prefer www) ----
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
</IfModule>

# ---- Block access to internals (repo files, dotfiles, docs) ----
<FilesMatch "(^\.|\.(env|example|md|ya?ml|lock|sh)$)">
  Require all denied
</FilesMatch>
RedirectMatch 404 ^/(includes|\.git|\.github)(/.*)?$

# ---- Security headers ----
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
  # CSP: allows Google fonts, GA4/GTM, Meta Pixel and the Cloudflare/Hostinger
  # edge analytics beacon. Inline scripts are used for the tag bootstraps, so
  # 'unsafe-inline' is permitted for scripts.
  # frame-src / form-action include https://www.facebook.com because the Meta
  # Pixel (fbevents.js) delivers some events via a hidden form POST + iframe to
  # facebook.com in addition to the image beacon. No other origin is widened.
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; img-src 'self' data: https://www.googletagmanager.com https://www.google-analytics.com https://www.facebook.com https://region1.google-analytics.com; font-src 'self' https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://connect.facebook.net https://static.cloudflareinsights.com; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com https://www.googletagmanager.com https://connect.facebook.net https://www.facebook.com https://cloudflareinsights.com; frame-src https://www.googletagmanager.com https://www.facebook.com; form-action 'self' https://www.facebook.com"
</IfModule>

# ---- MIME types ----
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType text/javascript .js
  AddType image/webp .webp
</IfModule>

# ---- Compression ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml application/xml
</IfModule>

# ---- Caching ----
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/x-icon              "access plus 1 year"
  ExpiresByType text/css                  "access plus 1 month"
  ExpiresByType application/javascript    "access plus 1 month"
  ExpiresByType image/svg+xml             "access plus 1 month"
  ExpiresByType application/manifest+json "access plus 1 week"
  # HTML / PHP responses: always revalidate so config, pricing and copy
  # changes are seen immediately.
  ExpiresByType text/html                 "access plus 0 seconds"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(webp|png|jpe?g|ico|css|js|svg)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.php$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
