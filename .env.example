# ============================================================
# SoloLedge marketing site — environment configuration
# ============================================================
# Copy to ".env" and fill in. On Hostinger, set these via
# hPanel > Advanced > Environment Variables (or a PHP prepend
# that calls putenv()). includes/config.php reads them with
# getenv() and falls back to safe defaults.
#
# Public IDs (GA4, GTM, Meta Pixel) are visible in the browser
# by design. Do NOT put any secret/private value in this file.
# ============================================================

# --- Site ---
SITE_URL=https://sololedge.jsinnovation.in

# --- Checkout (SuperProfile) ---
# The public "Get SoloLedge" buttons link here. Launch price and
# any coupon are configured inside SuperProfile, not here.
SUPERPROFILE_CHECKOUT_URL=https://superprofile.bio/vp/sololedge-v1

# --- Support ---
SUPPORT_EMAIL=support@jsinnovation.in

# --- Legal entity (used on the legal pages) ---
LEGAL_ENTITY_NAME=
LEGAL_ENTITY_ADDR=
LEGAL_JURISDICTION=
LEGAL_EFFECTIVE_DATE=

# --- Analytics (leave blank to disable). Use GTM_ID *or* GA4_MEASUREMENT_ID. ---
GTM_ID=
GA4_MEASUREMENT_ID=
META_PIXEL_ID=

# --- Google Search Console verification meta tag content ---
GSC_VERIFICATION=
